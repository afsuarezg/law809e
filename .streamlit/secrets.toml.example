# Copy this file to `.streamlit/secrets.toml` for local dev,
# or paste the contents into the Streamlit Cloud secrets editor.
# `.streamlit/secrets.toml` is gitignored.

# ---- Streamlit native OIDC (1.42+) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web app).
# Add these authorized redirect URIs in Google Console:
#   http://localhost:8501/oauth2callback                                   (local dev)
#   https://<your-app>.streamlit.app/oauth2callback                        (Streamlit Cloud)
# ---- App-specific allowlist of permitted reviewer emails ----
# Top-level (read via st.secrets["allowed_emails"]) — must come BEFORE
# any [section] header, since TOML keys after a header belong to that table.
# Only Google accounts whose email is in this list can use the app.
allowed_emails = [
  "asuarezg@stanford.edu",
  # add collaborators here
]

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_ME_WITH_A_RANDOM_64_CHAR_HEX_STRING"

# `st.login("google")` looks up creds under [auth.google].
[auth.google]
client_id = "REPLACE_ME_GOOGLE_CLIENT_ID"
client_secret = "REPLACE_ME_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- (optional) GitHub feedback persistence ----
# When set, save_feedback() also commits the per-reviewer JSON to this repo.
# Useful on Streamlit Cloud where the local filesystem is ephemeral.
# [github]
# token = "ghp_..."          # fine-grained PAT with Contents: write on the target repo
# owner = "afsuarezg"
# repo = "law809e"
# branch = "feedback-data"
# feedback_dir = "feedback"  # optional, defaults to "feedback"
